# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# Quo (formerly OpenPhone) - INBOUND, READ-ONLY.
# Generate in Quo under Settings > API. Requires Owner or Admin on the
# workspace. The adapter only ever issues GETs with this key.
QUO_API_KEY=

# Which tenant the local verification script polls.
QUO_TENANT=elite-pools

# The global outbound kill switch. Anything but the exact string "true" is off.
# Leave it unset in production until a human decides otherwise.
COMMS_SEND_ENABLED=false
